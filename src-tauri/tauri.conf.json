{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "board1",
  "version": "1.0.0",
  "identifier": "com.engus.board1",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "tsc -b && vite build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "board1",
        "width": 760,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
